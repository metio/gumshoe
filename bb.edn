           :requires ([gumshoe.main :as main])
           :task (System/exit (main/front-door *command-line-args*))}
  ;; babashka has a built-in `run`; the task replaces it, so `bb run <path>`
  ;; runs a listed book here exactly as it does in a casebook
  run {:doc "Launch a book - by fuzzy search, or by the path --list prints"
       :override-builtin true
       :requires ([gumshoe.main :as main])
       :task (System/exit (main/run *command-line-args*))}
