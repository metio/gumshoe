;; The Cluster API tool package. A casebook depends on it by subpath:
;;   {:deps {io.github.metio/gumshoe {:git/tag "…" :deps/root "tools/cluster-api"}}}
;; and lists gumshoe.tools.cluster-api under env.edn :plugins to join the
;; :platform scope and teach the wizard the :cluster-api capability.
{:paths ["libraries" "runbooks"]
 :deps {io.github.metio/gumshoe-core {:local/root "../.."}}}
