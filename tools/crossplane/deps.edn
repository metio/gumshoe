;; The Crossplane tool package. A casebook depends on it by subpath:
;;   {:deps {io.github.metio/gumshoe {:git/tag "…" :deps/root "tools/crossplane"}}}
;; and lists gumshoe.tools.crossplane under env.edn :plugins to join the
;; :platform scope and teach the wizard the :crossplane capability.
{:paths ["libraries" "runbooks"]
 :deps {io.github.metio/gumshoe-core {:local/root "../.."}}}
