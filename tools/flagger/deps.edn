;; The Flagger tool package. A casebook depends on it by subpath:
;;   {:deps {io.github.metio/gumshoe {:git/tag "…" :deps/root "tools/flagger"}}}
;; and lists gumshoe.tools.flagger under env.edn :plugins to join the :delivery
;; scope and teach the wizard the :flagger capability.
{:paths ["libraries" "runbooks"]
 :deps {io.github.metio/gumshoe-core {:local/root "../.."}}}
