;; The Traefik tool package. A casebook depends on it by subpath:
;;   {:deps {io.github.metio/gumshoe {:git/tag "…" :deps/root "tools/traefik"}}}
;; and lists gumshoe.tools.traefik under env.edn :plugins to join the
;; :traffic scope and teach the wizard the :traefik capability.
{:paths ["libraries" "runbooks"]
 :deps {io.github.metio/gumshoe-core {:local/root "../.."}}}
