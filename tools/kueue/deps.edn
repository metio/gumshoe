;; The Kueue tool package. A casebook depends on it by subpath:
;;   {:deps {io.github.metio/gumshoe {:git/tag "…" :deps/root "tools/kueue"}}}
;; and lists gumshoe.tools.kueue under env.edn :plugins to join the :workloads
;; scope and teach the wizard the :kueue capability.
{:paths ["libraries" "runbooks"]
 :deps {io.github.metio/gumshoe-core {:local/root "../.."}}}
