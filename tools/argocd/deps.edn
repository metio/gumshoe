;; The Argo CD tool package. A casebook depends on it by subpath:
;;   {:deps {io.github.metio/gumshoe {:git/tag "…" :deps/root "tools/argocd"}}}
;; and lists gumshoe.tools.argocd under env.edn :plugins to join the :gitops scope
;; and teach the wizard the :argocd capability.
{:paths ["libraries" "runbooks"]
 :deps {io.github.metio/gumshoe-core {:local/root "../.."}}}
