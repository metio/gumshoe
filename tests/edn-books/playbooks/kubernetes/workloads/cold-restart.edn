;; A procedure in the experimental gumshoe.dsl vocabulary: two scale changes
;; around a pause, under one confirmation. Run it with
;;   bb run tests/edn-books/playbooks/kubernetes/workloads/cold-restart.edn
;; which compiles it with gumshoe.dsl/compile-procedure and runs it as a
;; playbook.
{:gumshoe/dsl :v0-experimental
 :kind :procedure
 :description "Restarts a Deployment or StatefulSet cold: scales it to zero, waits for the operator, scales it back"
 :target {:pick :one :label "Workload" :flag :pick
          :parse :gumshoe.workloads/parse-pick
          :invalid "the pick is not \"<Kind> <namespace>/<name>\" of a Deployment or StatefulSet"
          :candidates [:call :gumshoe.workloads/scalable-picks [:context]]
          :empty "no Deployment or StatefulSet to restart"
          :gone "the workload no longer exists"}
 :options {:pick {:desc "\"<Kind> <namespace>/<name>\" - interactive selection when omitted"}
           :replicas {:desc "The replica count to scale back to" :alias :r :coerce :long :require true}}
 :prerequisites {:installed-tools ["kubectl" "fzf"]
                 :cluster-capabilities []
                 :kubectl-can-get ["deployments" "statefulsets" "horizontalpodautoscalers"]
                 :kubectl-can-patch ["deployments/scale" "statefulsets/scale"]}
 :confirm {:action "restart a workload cold"}
 :recovery "{target} may be left at zero replicas - scale it back with bb run runbooks/kubernetes/workloads/scale.clj --pick \"{target}\" --replicas {opt.replicas}"
 :steps [{:title "scale to zero"
          :reads {:hpas [:list "horizontalpodautoscalers" {:namespace [:ref :namespace]}]}
          :values {:replicas 0}
          :state {:holds [:call :gumshoe.workloads/scaled? [:object] [:value :replicas]]
                  :says "{target} runs no replica"
                  :timeout 600 :interval 10}
          :refuse [{:reason [:call :gumshoe.workloads/scale-refusal-given
                             [:ref :kind] [:object] [:read :hpas] [:value :replicas]]}]
          :confirm {:action "scale the workload to zero" :destructive? false}
          :announce "Scale {target} to zero for a cold restart"
          :effect [[:kubectl :scale {:replicas [:value :replicas]}]]}
         [:pause {:says "do what needs the workload stopped, then continue"}]
         {:title "scale back"
          :reads {:hpas [:list "horizontalpodautoscalers" {:namespace [:ref :namespace]}]}
          :values {:replicas [:opt :replicas]}
          :state {:holds [:call :gumshoe.workloads/scaled? [:object] [:value :replicas]]
                  :says "{target} runs {value.replicas} ready replica(s)"
                  :timeout 600 :interval 10}
          :refuse [{:reason [:call :gumshoe.workloads/scale-refusal-given
                             [:ref :kind] [:object] [:read :hpas] [:value :replicas]]}]
          :confirm {:action "scale the workload back" :destructive? false}
          :announce "Scale {target} back to {value.replicas} replica(s)"
          :effect [[:kubectl :scale {:replicas [:value :replicas]}]]}]}
