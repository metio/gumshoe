;; runbooks/kubernetes/objects/delete.clj written in the experimental
;; gumshoe.dsl vocabulary. Run it with
;;   bb run tests/edn-books/runbooks/kubernetes/objects/delete.edn
;; which compiles it with gumshoe.dsl/compile and runs it as the book runs.
{:gumshoe/dsl :v0-experimental
 :description "Deletes one namespaced object after a server-side dry run accepted it"
 :target {:pick :one :label "Object" :flag :pick
          :parse :gumshoe.deletion/parse-pick
          :invalid "the pick is not \"<type> <namespace>/<name>\" of deployments, statefulsets, daemonsets, jobs, cronjobs, pods, services, ingresses, configmaps, persistentvolumeclaims"
          :candidates [:call :gumshoe.deletion/candidates [:context]]
          :empty "nothing to delete"
          :gone "the object no longer exists"}
 :options {:pick {:desc "\"<type> <namespace>/<name>\" - interactive selection when omitted"}}
 :prerequisites {:installed-tools ["kubectl" "fzf"]
                 :cluster-capabilities []
                 :kubectl-can-get ["deployments" "statefulsets" "daemonsets" "jobs" "cronjobs" "pods"
                                   "services" "ingresses" "configmaps" "persistentvolumeclaims"]
                 :kubectl-can-delete ["deployments" "statefulsets" "daemonsets" "jobs" "cronjobs" "pods"
                                      "services" "ingresses" "configmaps" "persistentvolumeclaims"]}
 :values {:dry-run [:call :gumshoe.deletion/dry-run [:context] [:ref]]
          :dependents [:call :gumshoe.deletion/read-dependents [:context] [:ref]]}
 :state {:holds :absent
         :says "{target} is gone or terminating"
         :timeout 60 :interval 5}
 :refuse [{:when [:not [:= [:value :dry-run :ok?] true]]
           :says "the dry run was refused: {value.dry-run.message}"}]
 :confirm {:action "delete an object" :destructive? true}
 :items [:call :gumshoe.deletion/deletion-items [:target] [:value :dry-run] [:value :dependents]]
 :announce "Delete {target}"
 :effect [[:kubectl :delete]]
 :recovery "A deleted object is gone from the cluster: recreate {target} from where it is declared (its GitOps source, Helm release or manifest), or restore it from a backup."
 :opt-out {:done "a pick that names no object is refused as a likely typo instead of skipped as already deleted"}}
